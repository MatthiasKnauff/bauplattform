# Einstellungen der Bauplattform. update.sh legt beim ersten Mal daraus die Datei .env an
# und übernimmt dabei Kennwörter und Schlüssel aus den bisherigen Containern.
# Die Datei .env bleibt bei Updates erhalten und wird nie überschrieben.

# Datenbank-Kennwort – muss zum bestehenden Volume passen (bisher in docker-compose.yml des Bautagebuchs)
DB_PASSWORD=
# Schlüssel für die Anmelde-Cookies des Bautagebuchs (leer = wird im Datenordner erzeugt)
SECRET_KEY=
TZ=Europe/Berlin

# Ports auf dem Server ("8080" = von überall im Netz, "127.0.0.1:8080" = nur für einen Reverse Proxy auf dem Server)
BAUTAGEBUCH_PUBLISH=8080
GANTT_PUBLISH=8082
PORTAL_PUBLISH=8090
ADMIN_PUBLISH=8091
ADRESSEN_PUBLISH=8093
BAUKOSTEN_PUBLISH=8094
# Ports, unter denen der Browser die Apps erreicht (meist dieselben wie oben)
BAUTAGEBUCH_PORT=8080
GANTT_PORT=8082
PORTAL_PORT=8090
ADMIN_PORT=8091
ADRESSEN_PORT=8093
BAUKOSTEN_PORT=8094

# Hinter einem Reverse Proxy mit eigenen Adressen (sonst leer lassen):
# BAUTAGEBUCH_URL=https://bautagebuch.firma.de
# GANTT_URL=https://plan.firma.de
# PORTAL_URL=https://start.firma.de
# ADMIN_URL=https://verwaltung.firma.de
# ADRESSEN_URL=https://adressen.firma.de
# BAUKOSTEN_URL=https://baukosten.firma.de
# IP oder Name des Servers: Apps ohne eigene Adresse (z. B. Adressen) werden dann über http://SERVER_HOST:Port verlinkt
# SERVER_HOST=192.168.1.20
# SSO_COOKIE_DOMAIN=firma.de
TRUST_PROXY=0
COOKIE_SECURE=0

# Volume der Datenbank (alle Apps). Umstellen auf bauportal_pgdata: README → „Datenbank-Volume umbenennen“
# DB_VOLUME=bauportal_pgdata

# Volume der bisherigen Gantt-App (wird beim ersten Start einmalig übernommen)
GANTT_LEGACY_VOLUME=gantt-app_gantt-data
# KI für alle Apps (Auswahl oben in der Kopfleiste jeder App)
# Eigene KI im Büro: Ollama-Container (startet automatisch mit). Modell z. B. qwen2.5:3b (≈3 GB RAM) oder qwen2.5:7b (≈6 GB RAM)
OLLAMA_MODEL=qwen2.5:3b
# Externe Anbieter (optional, kostenpflichtig je Anfrage) – leer = in der Auswahl nicht verfügbar
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
